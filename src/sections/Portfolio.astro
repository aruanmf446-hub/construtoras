---
/**
 * (05) Full portfolio with category filter.
 * variant 'index'  → editorial index rows with cursor-following preview (desktop)
 * variant 'mosaic' → asymmetric editorial mosaic
 */
import Media from '../components/Media.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { content } from '../content';
import { projects as allProjects, type Project } from '../content/projects';
import { pad } from '../lib/text';
import { projectHref } from '../lib/routes';
import type { SectionProps } from '../lib/section';

interface Props extends SectionProps {
  projects?: Project[];
  /** Hide the section header (e.g. when the page header already introduces it). */
  bare?: boolean;
}
const { anchor, navLabel, index, variant = 'index', projects = allProjects, bare = false } = Astro.props;
const p = content.portfolio;
const cats = Array.from(new Set(projects.map((x) => x.category)));
const slug = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-');
// Mosaic rhythm: column spans / offsets repeat every 5 items.
const rhythm = ['m-a', 'm-b', 'm-c', 'm-d', 'm-e'];
---
{projects.length > 0 && (
<section class:list={['pf section', `pf--${variant}`]} id={anchor} data-nav-label={navLabel} data-pf aria-label={p.eyebrow}>
  <div class="container">
    {!bare && <SectionHeader index={index} eyebrow={p.eyebrow} title={p.title} intro={p.intro} />}

    {cats.length > 1 && (
      <div class="pf__filters" role="group" aria-label={content.ui.filterCategory} data-reveal="fade">
        <button type="button" class="pf__filter label" aria-pressed="true" data-filter="*">
          {p.allLabel} <sup class="tabular">{pad(projects.length)}</sup>
        </button>
        {cats.map((c) => (
          <button type="button" class="pf__filter label" aria-pressed="false" data-filter={slug(c)}>
            {c} <sup class="tabular">{pad(projects.filter((x) => x.category === c).length)}</sup>
          </button>
        ))}
      </div>
    )}
    <p class="sr-only" aria-live="polite" data-pf-status data-count-label={content.ui.projectCount}></p>

    {variant === 'mosaic' ? (
      <ul class="pf__mosaic">
        {projects.map((x, i) => {
          const href = projectHref(x.slug);
          const Tag = href ? 'a' : 'div';
          return (
            <li class:list={['pf__tile', rhythm[i % rhythm.length]]} data-cat={slug(x.category)} data-project>
              <Tag href={href ?? undefined} class="pf__tile-link" data-project-link={href ? '' : undefined}>
                <div data-vt-media class="pf__tile-media">
                  <Media src={x.cover} alt={x.coverAlt} sizes="(min-width: 900px) 50vw, 100vw" reveal="mask" />
                </div>
                <div class="pf__tile-cap">
                  <span class="label subtle tabular">{pad(i + 1)}</span>
                  <h3 class="display t-lg">{x.name}</h3>
                  <span class="label muted">{x.category} · {x.location.city} · {x.year}</span>
                </div>
              </Tag>
            </li>
          );
        })}
      </ul>
    ) : (
      <div class="pf__index">
        <div class="pf__head label subtle" aria-hidden="true">
          <span>{content.ui.number}</span><span>{content.ui.project}</span><span>{content.ui.category}</span><span>{content.ui.location}</span><span>{content.ui.year}</span><span>{content.ui.status}</span>
        </div>
        <ul>
          {projects.map((x, i) => {
            const href = projectHref(x.slug);
            const Tag = href ? 'a' : 'div';
            return (
              <li class="pf__row" data-cat={slug(x.category)} data-project data-reveal="fade">
                <Tag href={href ?? undefined} class="pf__row-link" data-project-link={href ? '' : undefined} data-preview={x.slug}>
                  <span class="label subtle tabular pf__n">{pad(i + 1)}</span>
                  <span class="pf__thumb" data-vt-media><Media src={x.cover} alt="" sizes="30vw" /></span>
                  <span class="display pf__name">{x.name}</span>
                  <span class="label muted pf__cat">{x.category}</span>
                  <span class="label muted pf__loc">{x.location.city}, {x.location.region}</span>
                  <span class="label muted pf__year tabular">{x.year}</span>
                  <span class="label pf__status"><i aria-hidden="true"></i>{x.status}</span>
                </Tag>
              </li>
            );
          })}
        </ul>
        <div class="pf__preview" aria-hidden="true" data-pf-preview>
          {projects.map((x) => (
            <div class="pf__preview-item" data-preview-item={x.slug}><Media src={x.cover} alt="" sizes="28vw" /></div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
)}

<style>
  .pf__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-bottom: 2.5rem;
  }
  .pf__filter {
    padding: 0.4rem 0;
    color: var(--color-ink-subtle);
    border-bottom: 1px solid transparent;
    transition: color 0.3s, border-color 0.3s;
  }
  .pf__filter:hover,
  .pf__filter[aria-pressed='true'] {
    color: var(--color-ink);
    border-color: var(--color-accent);
  }
  .pf__filter sup {
    font-size: 0.85em;
    color: var(--color-accent);
  }
  [data-cat].is-hidden {
    display: none;
  }

  /* ---- Index ---- */
  .pf__index {
    position: relative;
  }
  .pf__head {
    display: none;
  }
  .pf__row {
    border-top: var(--shape-border) solid var(--color-line);
  }
  .pf__row:last-child {
    border-bottom: var(--shape-border) solid var(--color-line);
  }
  .pf__row-link {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    grid-template-areas: 'thumb name' 'thumb meta';
    column-gap: 1rem;
    row-gap: 0.4rem;
    padding-block: 1rem;
    align-items: center;
  }
  .pf__n,
  .pf__loc,
  .pf__year {
    display: none;
  }
  .pf__thumb {
    grid-area: thumb;
    display: block;
  }
  .pf__thumb :global(.media) {
    aspect-ratio: 1;
  }
  .pf__name {
    grid-area: name;
    font-size: clamp(1.6rem, 3.6vw, 3.4rem);
    line-height: 1;
    transition: transform 0.7s var(--motion-ease-out), color 0.4s;
  }
  .pf__cat {
    grid-area: meta;
  }
  .pf__status {
    display: none;
    align-items: center;
    gap: 0.5rem;
  }
  .pf__status i {
    width: 6px;
    height: 6px;
    background: var(--color-accent);
  }
  .pf__preview {
    display: none;
  }
  @media (min-width: 900px) {
    .pf__head {
      display: grid;
      grid-template-columns: 4rem 1fr 10rem 12rem 5rem 8rem;
      gap: var(--layout-gutter);
      padding-bottom: 0.75rem;
    }
    .pf__row-link {
      grid-template-columns: 4rem 1fr 10rem 12rem 5rem 8rem;
      grid-template-areas: none;
      gap: var(--layout-gutter);
      padding-block: 1.6rem;
    }
    .pf__n,
    .pf__loc,
    .pf__year {
      display: block;
    }
    .pf__status {
      display: inline-flex;
    }
    .pf__cat {
      grid-area: auto;
    }
    .pf__name {
      grid-area: auto;
    }
    .pf__thumb {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      opacity: 0;
    }
    .pf__row-link:hover .pf__name,
    .pf__row-link:focus-visible .pf__name {
      transform: translateX(1.25rem);
      color: var(--color-accent);
    }
    .pf__preview {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 20;
      width: clamp(16rem, 24vw, 26rem);
      aspect-ratio: 4 / 5;
      pointer-events: none;
      overflow: hidden;
      clip-path: inset(50% 50% 50% 50%);
      transition: clip-path 0.7s var(--motion-ease-out);
    }
    .pf__preview.is-on {
      clip-path: inset(0 0 0 0);
    }
    .pf__preview-item {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 0.4s;
    }
    .pf__preview-item :global(.media) {
      height: 100%;
    }
    .pf__preview-item.is-active {
      opacity: 1;
    }
  }

  /* ---- Mosaic ---- */
  .pf__mosaic {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(3rem, 7vw, 6rem) var(--layout-gutter);
  }
  .pf__tile {
    grid-column: 1 / -1;
  }
  .pf__tile-link {
    display: grid;
    gap: 1rem;
  }
  .pf__tile-media {
    overflow: hidden;
  }
  .pf__tile-media :global(.media) {
    aspect-ratio: 4 / 3;
  }
  .pf__tile-media :global(img) {
    transition: transform 1.4s var(--motion-ease-out);
  }
  .pf__tile-link:hover .pf__tile-media :global(img) {
    transform: scale(1.04);
  }
  .pf__tile-cap {
    display: grid;
    gap: 0.4rem;
  }
  @media (min-width: 900px) {
    .m-a { grid-column: 1 / span 7; }
    .m-b { grid-column: 9 / span 4; margin-top: 30%; }
    .m-b .pf__tile-media :global(.media) { aspect-ratio: 3 / 4; }
    .m-c { grid-column: 2 / span 5; }
    .m-c .pf__tile-media :global(.media) { aspect-ratio: 4 / 5; }
    .m-d { grid-column: 7 / span 6; margin-top: 18%; }
    .m-e { grid-column: 1 / -1; }
    .m-e .pf__tile-media :global(.media) { aspect-ratio: 21 / 9; }
  }
</style>

<script>
  import { ScrollTrigger, isTouch } from '../scripts/motion/core';

  document.querySelectorAll<HTMLElement>('[data-pf]').forEach((root) => {
    /* Filtering */
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = root.querySelectorAll<HTMLElement>('[data-cat]');
    const status = root.querySelector<HTMLElement>('[data-pf-status]');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter!;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        let n = 0;
        items.forEach((it) => {
          const show = f === '*' || it.dataset.cat === f;
          it.classList.toggle('is-hidden', !show);
          if (show) {
            n++;
            // make sure revealed state applies to items that were hidden before entering view
            it.style.opacity = '';
            it.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
              el.style.clipPath = 'none';
            });
            if (it.dataset.reveal) { it.style.opacity = '1'; it.style.transform = 'none'; }
          }
        });
        if (status) status.textContent = `${n} ${status.dataset.countLabel}`;
        ScrollTrigger.refresh();
      })
    );

    /* Cursor preview (index variant, pointer devices) */
    const preview = root.querySelector<HTMLElement>('[data-pf-preview]');
    if (!preview || isTouch()) return;
    const previews = new Map(Array.from(preview.querySelectorAll<HTMLElement>('[data-preview-item]')).map((el) => [el.dataset.previewItem!, el]));
    let x = 0, y = 0, tx = 0, ty = 0, raf = 0;
    const loop = () => {
      x += (tx - x) * 0.14;
      y += (ty - y) * 0.14;
      preview.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(loop) : 0;
    };
    root.querySelectorAll<HTMLElement>('[data-preview]').forEach((row) => {
      row.addEventListener('pointerenter', () => {
        previews.forEach((el, k) => el.classList.toggle('is-active', k === row.dataset.preview));
        preview.classList.add('is-on');
      });
      row.addEventListener('pointerleave', () => preview.classList.remove('is-on'));
    });
    root.addEventListener('pointermove', (e) => {
      const w = preview.offsetWidth, h = preview.offsetHeight;
      tx = Math.min(window.innerWidth - w - 16, e.clientX + 32);
      ty = Math.min(window.innerHeight - h - 16, Math.max(16, e.clientY - h / 2));
      if (!raf) raf = requestAnimationFrame(loop);
    });
  });
</script>
