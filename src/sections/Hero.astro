---
/**
 * (01) Cinematic hero — modes: 'image' | 'video' | 'webgl' (site.config.ts → hero.mode).
 * The same markup serves all three; the image is always rendered as the base layer,
 * so every mode degrades gracefully (no video file, no WebGL, reduced motion, no JS).
 */
import { getImage } from 'astro:assets';
import Media from '../components/Media.astro';
import Headline from '../components/Headline.astro';
import Button from '../components/Button.astro';
import Slats from '../components/Slats.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../config/site.config';
import { content } from '../content';
import { firstAvailable } from '../lib/media';
import { resolveCta } from '../lib/routes';
import type { SectionProps } from '../lib/section';

interface Props extends SectionProps {
  /** Override mode for a single page. */
  mode?: 'image' | 'video' | 'webgl';
}
const { anchor, navLabel = 'Início', page, mode: modeProp } = Astro.props;
const h = content.hero;
const mode = modeProp ?? site.hero.mode;
const imagePath = h.image ?? site.hero.image;
const imageMobilePath = h.imageMobile ?? site.hero.imageMobile;
const base = firstAvailable(imagePath);
const video = site.hero.video;
const hasVideo = mode === 'video' && (video.mp4 || video.webm);
// Texture / poster sized for the shader and video.
const tex = base && (mode === 'webgl' || hasVideo) ? await getImage({ src: base, width: Math.min(2048, base.width), format: 'jpg', quality: 82 }) : null;
const baseMobile = firstAvailable(imageMobilePath ?? imagePath);
const texMobile = baseMobile && mode === 'webgl' ? await getImage({ src: baseMobile, width: Math.min(1200, baseMobile.width), format: 'jpg', quality: 80 }) : null;
const primary = resolveCta(h.primary.to, page ?? undefined);
const secondary = h.secondary ? resolveCta(h.secondary.to, page ?? undefined) : null;
---
<section class="hero" id={anchor} data-nav-label={navLabel} data-intro data-hero data-mode={hasVideo ? 'video' : mode === 'video' ? 'image' : mode} aria-labelledby={`${anchor}-title`}>
  <div class="hero__media" data-hero-media>
    <div class="hero__layer" data-hero-layer>
      <Media src={imagePath} srcMobile={imageMobilePath} alt={h.imageAlt} priority sizes="100vw" class="hero__img" />
      {hasVideo && (
        <video class="hero__video" muted loop playsinline preload="none" poster={tex?.src} data-hero-video aria-hidden="true">
          {video.webm && <source src={video.webm} type="video/webm" />}
          {video.mp4 && <source src={video.mp4} type="video/mp4" />}
        </video>
      )}
      {mode === 'webgl' && tex && <canvas class="hero__canvas" data-hero-canvas data-src={tex.src} data-src-mobile={texMobile?.src} aria-hidden="true"></canvas>}
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>
    <Slats count={7} />
  </div>

  <span class="mark" style="top:7rem;left:var(--layout-margin)" aria-hidden="true"></span>
  <span class="mark" style="top:7rem;right:var(--layout-margin)" aria-hidden="true"></span>

  <div class="hero__content container" data-hero-content>
    <p class="hero__eyebrow label" data-intro-fade>{h.eyebrow}</p>
    <Headline lines={h.title} as="h1" size="mega" class="hero__title" reveal={false} id={`${anchor}-title`} />
    <div class="hero__foot">
      <p class="hero__sub" data-intro-fade>{h.subtitle}</p>
      <div class="hero__ctas" data-intro-fade>
        <Button href={primary} label={h.primary.label} variant="solid" />
        {h.secondary && <Button href={secondary} label={h.secondary.label} />}
      </div>
      <dl class="hero__meta" data-intro-fade>
        {h.meta.map((m) => (
          <div><dt class="label subtle">{m.label}</dt><dd class="label">{m.value}</dd></div>
        ))}
      </dl>
    </div>
  </div>

  <a class="hero__scroll label" href="#conteudo-inicio" data-intro-fade aria-label={content.ui.scroll}>
    <span>{content.ui.scroll}</span>
    <Arrow direction="down" class="hero__scroll-arrow" />
  </a>
  <span id="conteudo-inicio" class="hero__end" aria-hidden="true"></span>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: clip;
    color: #f3eee6;
    background: var(--color-bg);
  }
  .hero__media {
    position: absolute;
    inset: 0;
    --slat-color: var(--color-bg);
  }
  .hero__layer {
    position: absolute;
    inset: 0;
    will-change: transform;
  }
  .hero__layer :global(.hero__img) {
    position: absolute;
    inset: 0;
  }
  .hero__video,
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.2s var(--motion-ease-out);
    filter: var(--image-filter);
  }
  .hero__video.is-ready,
  .hero__canvas.is-ready {
    opacity: 1;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.42) 0%, transparent 22%),
      linear-gradient(0deg, var(--color-scrim) 0%, transparent 62%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.35) 0%, transparent 55%);
  }
  @media (max-width: 699px) {
    .hero__scrim {
      background:
        linear-gradient(180deg, rgba(0, 0, 0, 0.45) 0%, transparent 20%),
        linear-gradient(0deg, rgba(8, 7, 6, 0.86) 0%, rgba(8, 7, 6, 0.55) 45%, transparent 75%);
    }
  }
  .hero__content {
    position: relative;
    z-index: 3;
    padding-top: 8rem;
    padding-bottom: clamp(5.5rem, 7vw, 4.5rem);
  }
  .hero__eyebrow {
    margin-bottom: clamp(1rem, 2vw, 2rem);
    color: rgba(243, 238, 230, 0.75);
  }
  .hero__content :global(.hero__title) {
    font-size: clamp(3.2rem, min(12.5vw, 21vh), 16rem);
    margin-left: -0.04em;
  }
  .hero__content :global(.hero__title .line:nth-child(2)) {
    padding-left: clamp(1.5rem, 8vw, 11rem);
  }
  .hero__content :global(.hero__title .accent) {
    color: #f3eee6;
  }
  .hero__foot {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 2rem var(--layout-gutter);
    margin-top: clamp(2rem, 4vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid rgba(243, 238, 230, 0.22);
    align-items: start;
  }
  .hero__sub {
    grid-column: 1 / -1;
    max-width: 40ch;
    color: rgba(243, 238, 230, 0.82);
  }
  .hero__ctas {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__ctas :global(.btn) {
    --btn-ink: #f3eee6;
  }
  .hero__ctas :global(.btn--solid) {
    --btn-bg: #f3eee6;
    --btn-ink: #121110;
  }
  .hero__meta {
    display: none;
  }
  .hero__meta dd {
    margin-top: 0.3rem;
  }
  .hero__scroll {
    position: absolute;
    z-index: 3;
    right: var(--layout-margin);
    top: 9rem;
    display: none;
    align-items: center;
    gap: 0.75rem;
    writing-mode: vertical-rl;
    color: rgba(243, 238, 230, 0.75);
  }
  .hero__scroll :global(.hero__scroll-arrow) {
    width: 0.8rem;
    height: 2rem;
    transform: none !important;
  }
  .hero__end {
    position: absolute;
    bottom: 0;
  }
  .mark {
    z-index: 3;
    color: rgba(243, 238, 230, 0.5);
  }
  @media (min-width: 700px) {
    .hero__sub {
      grid-column: 1 / span 6;
    }
    .hero__ctas {
      grid-column: 7 / -1;
      justify-content: flex-end;
    }
  }
  @media (min-width: 1100px) {
    .hero__sub {
      grid-column: 1 / span 4;
    }
    .hero__ctas {
      grid-column: 5 / span 5;
      justify-content: flex-start;
    }
    .hero__meta {
      grid-column: 10 / -1;
      display: grid;
      grid-template-columns: repeat(3, auto);
      justify-content: end;
      gap: 2rem;
    }
    .hero__scroll {
      display: flex;
    }
  }
  @media (max-width: 899px) {
    .hero__content {
      padding-bottom: 6.5rem;
    }
  }
</style>

<script>
  import { gsap, motionOk, isTouch } from '../scripts/motion/core';
  import { animateLines, animateSlats } from '../scripts/motion/reveal';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const ok = motionOk();
    const layer = hero.querySelector<HTMLElement>('[data-hero-layer]')!;
    const content = hero.querySelector<HTMLElement>('[data-hero-content]')!;
    const title = hero.querySelector<HTMLElement>('.hero__title')!;
    const fades = hero.querySelectorAll<HTMLElement>('[data-intro-fade]');
    const slats = hero.querySelector<HTMLElement>('[data-slats]');

    /* Intro */
    if (ok) {
      gsap.set(title.querySelectorAll('.line__inner'), { yPercent: 110 });
      gsap.set(fades, { opacity: 0, y: 24 });
      const tl = gsap.timeline({ delay: 0.15 });
      tl.fromTo(layer, { scale: 1.28 }, { scale: 1, duration: 2.6, ease: 'expo.out' }, 0);
      if (slats) tl.add(animateSlats(slats), 0);
      tl.add(animateLines(title), 0.55);
      tl.to(fades, { opacity: 1, y: 0, duration: 1.2, ease: 'expo.out', stagger: 0.08 }, 1.0);

      /* Scroll choreography: media drifts & scales, copy lifts away */
      gsap.to(layer, {
        yPercent: 14,
        scale: 1.08,
        ease: 'none',
        scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true },
      });
      gsap.to(content, {
        yPercent: -18,
        opacity: 0.15,
        ease: 'none',
        scrollTrigger: { trigger: hero, start: 'center center', end: 'bottom top', scrub: true },
      });
    }

    /* Video mode */
    const video = hero.querySelector<HTMLVideoElement>('[data-hero-video]');
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    if (video && ok && !conn?.saveData) {
      video.preload = 'auto';
      video.addEventListener('playing', () => video.classList.add('is-ready'), { once: true });
      video.play().catch(() => video.remove());
      // Pause when out of view to save resources.
      new IntersectionObserver(([e]) => (e.isIntersecting ? video.play().catch(() => {}) : video.pause())).observe(hero);
    } else video?.remove();

    /* WebGL mode */
    const canvas = hero.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    const nav = navigator as Navigator & { deviceMemory?: number; connection?: { saveData?: boolean } };
    // The shader is an enhancement: skip it on low-power / data-saver devices.
    const capable = (nav.deviceMemory ?? 8) >= 4 && (navigator.hardwareConcurrency ?? 8) >= 4 && !nav.connection?.saveData;
    // Progressive enhancement: the shader boots on the first user interaction,
    // so the initial load stays light (the still image is already on screen).
    const whenIdle = (fn: () => void) => {
      const events = ['pointermove', 'pointerdown', 'wheel', 'scroll', 'keydown', 'touchstart'];
      let done = false;
      const go = () => {
        if (done) return;
        done = true;
        events.forEach((ev) => removeEventListener(ev, go));
        'requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 800 }) : setTimeout(fn, 100);
      };
      events.forEach((ev) => addEventListener(ev, go, { passive: true, once: true }));
    };
    if (canvas && ok && capable) {
      whenIdle(() => import('../scripts/webgl/hero-shader')
        .then(({ createHeroShader }) => createHeroShader(canvas, (window.innerWidth <= 700 && canvas.dataset.srcMobile) || canvas.dataset.src!, hero, { pointer: !isTouch() }))
        .then((ctrl) => {
          if (!ctrl) canvas.remove();
        })
        .catch(() => canvas.remove()));
    } else canvas?.remove();
  }
</script>
