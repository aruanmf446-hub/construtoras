---
/** (16) Architectural gallery — asymmetric collage with layered parallax + accessible lightbox. */
import { getImage } from 'astro:assets';
import Media from '../components/Media.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { content } from '../content';
import { firstAvailable } from '../lib/media';
import { pad } from '../lib/text';
import type { MediaRef } from '../content/schema';
import type { SectionProps } from '../lib/section';

interface Props extends SectionProps {
  images?: MediaRef[];
  title?: string[];
  eyebrow?: string;
}
const { anchor, navLabel, index, images, title, eyebrow } = Astro.props;
const g = content.gallery;
const list = images ?? g.images;
const large = await Promise.all(
  list.map(async (im) => {
    const src = firstAvailable(im.src);
    return src ? (await getImage({ src, width: Math.min(2200, src.width), format: 'webp', quality: 80 })).src : '';
  })
);
const slots = ['g-a', 'g-b', 'g-c', 'g-d', 'g-e', 'g-f'];
const speeds = [0.08, 0.22, 0.14, 0.06, 0.2, 0.1];
---
{list.length > 0 && (
<section class="ga section" id={anchor} data-nav-label={navLabel} data-ga aria-label={eyebrow ?? g.eyebrow}>
  <div class="container">
    <SectionHeader index={index} eyebrow={eyebrow ?? g.eyebrow} title={title ?? g.title} />
    <ul class="ga__grid">
      {list.map((im, i) => (
        <li class:list={['ga__item', slots[i % slots.length]]} data-ga-depth={speeds[i % speeds.length]}>
          <button type="button" class="ga__btn" data-ga-open={i} aria-label={`${content.ui.enlargeImage}: ${im.caption ?? im.alt}`}>
            <Media src={im.src} alt={im.alt} sizes="(min-width: 900px) 50vw, 100vw" reveal="mask" />
          </button>
          {im.caption && <p class="label subtle ga__cap"><span class="tabular">{pad(i + 1)}</span> {im.caption}</p>}
        </li>
      ))}
    </ul>
  </div>

  <dialog class="lb" data-lb aria-label={content.ui.expandedGallery}>
    <figure class="lb__figure">
      <img data-lb-img alt="" />
      <figcaption class="label lb__cap"><span class="tabular" data-lb-count></span> <span data-lb-cap></span></figcaption>
    </figure>
    <div class="lb__controls">
      <button type="button" class="label lb__btn" data-lb-prev>{content.ui.previousImage}</button>
      <button type="button" class="label lb__btn" data-lb-next>{content.ui.nextImage}</button>
      <button type="button" class="label lb__btn lb__close" data-lb-close>{content.ui.close} ✕</button>
    </div>
    <script type="application/json" data-lb-data set:html={JSON.stringify(list.map((im, i) => ({ src: large[i], alt: im.alt, caption: im.caption ?? '' })))} />
  </dialog>
</section>
)}

<style>
  .ga__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4rem) var(--layout-gutter);
  }
  .ga__item {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.75rem;
    will-change: transform;
  }
  .ga__btn {
    display: block;
    width: 100%;
    cursor: zoom-in;
  }
  .ga__btn :global(.media) {
    aspect-ratio: 4 / 3;
  }
  .ga__btn :global(img) {
    transition: transform 1.2s var(--motion-ease-out), filter 0.6s;
  }
  .ga__btn:hover :global(img) {
    transform: scale(1.03);
  }
  .g-b .ga__btn :global(.media),
  .g-c .ga__btn :global(.media) {
    aspect-ratio: 3 / 4;
  }
  @media (max-width: 899px) {
    .g-b,
    .g-c {
      grid-column: span 6;
    }
  }
  @media (min-width: 900px) {
    .g-a { grid-column: 1 / span 7; }
    .g-b { grid-column: 9 / span 4; margin-top: 30%; }
    .g-c { grid-column: 2 / span 4; margin-top: -8%; }
    .g-d { grid-column: 7 / span 6; margin-top: 12%; }
    .g-e { grid-column: 1 / span 5; }
    .g-e .ga__btn :global(.media) { aspect-ratio: 1; }
    .g-f { grid-column: 7 / span 6; margin-top: 20%; }
  }

  .lb {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(1rem, 3vw, 3rem);
    border: 0;
    background: color-mix(in srgb, var(--color-bg) 96%, transparent);
    color: var(--color-ink);
  }
  .lb[open] {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 1rem;
  }
  .lb::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }
  .lb__figure {
    min-height: 0;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 1rem;
  }
  .lb__figure img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
    animation: lb-in 0.8s var(--motion-ease-out);
  }
  @keyframes lb-in {
    from { opacity: 0; transform: scale(0.98); }
  }
  .lb__cap {
    color: var(--color-ink-muted);
  }
  .lb__controls {
    display: flex;
    gap: 1.5rem;
    justify-content: flex-end;
  }
  .lb__close {
    margin-left: auto;
  }
  .lb__btn {
    padding: 0.6rem 0;
  }
  .lb__btn:hover {
    color: var(--color-accent);
  }
</style>

<script>
  import { gsap, motionOk, lockScroll } from '../scripts/motion/core';

  document.querySelectorAll<HTMLElement>('[data-ga]').forEach((root) => {
    if (motionOk() && window.matchMedia('(min-width: 900px)').matches) {
      root.querySelectorAll<HTMLElement>('[data-ga-depth]').forEach((el) => {
        const d = Number(el.dataset.gaDepth);
        gsap.fromTo(el, { y: d * 220 }, { y: -d * 220, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true } });
      });
    }

    const dialog = root.querySelector<HTMLDialogElement>('[data-lb]');
    const dataEl = root.querySelector('[data-lb-data]');
    if (!dialog || !dataEl || typeof dialog.showModal !== 'function') return;
    const items: { src: string; alt: string; caption: string }[] = JSON.parse(dataEl.textContent || '[]');
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const cap = dialog.querySelector<HTMLElement>('[data-lb-cap]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    let current = 0;
    let opener: HTMLElement | null = null;
    const show = (i: number) => {
      current = (i + items.length) % items.length;
      const it = items[current];
      img.src = it.src;
      img.alt = it.alt;
      img.style.animation = 'none';
      void img.offsetWidth;
      img.style.animation = '';
      cap.textContent = it.caption;
      count.textContent = `${String(current + 1).padStart(2, '0')} / ${String(items.length).padStart(2, '0')}`;
    };
    root.querySelectorAll<HTMLElement>('[data-ga-open]').forEach((btn) =>
      btn.addEventListener('click', () => {
        opener = btn;
        show(Number(btn.dataset.gaOpen));
        dialog.showModal();
        lockScroll(true);
      })
    );
    dialog.addEventListener('close', () => {
      lockScroll(false);
      opener?.focus();
    });
    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(current + 1));
    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
  });
</script>
