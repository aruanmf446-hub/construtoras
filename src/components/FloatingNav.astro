---
/**
 * Floating navigation dock.
 * - Desktop: floats at the top; compacts on scroll down, expands on scroll up / hover.
 * - Mobile: floats at the bottom (thumb reach) with menu + WhatsApp.
 * - Menu panel built dynamically from enabled pages + the current page's sections.
 */
import Logo from './Logo.astro';
import { site } from '../config/site.config';
import { content } from '../content';
import { mainNav, sectionIndex, whatsappHref, pageHref } from '../lib/routes';
import { pad } from '../lib/text';
import type { PageId, SectionRef } from '../config/types';

interface Props {
  page: PageId | null;
  extraSections?: SectionRef[];
  customIndex?: { label: string; anchor: string }[];
}
const { page, extraSections = [], customIndex = [] } = Astro.props;
const nav = mainNav();
const index = [...customIndex, ...sectionIndex(page, extraSections)];
const wa = whatsappHref();
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  return h === '/' ? current === '/' : current === h || current.startsWith(h + '/');
};
const { ui } = content;
const c = site.contact;
---
<div class="dock" data-dock data-state="expanded">
  <nav class="dock__bar" aria-label={ui.mainNavigation}>
    <a href={pageHref('home') ?? '/'} class="dock__brand" aria-label={`${site.identity.name} — ${ui.backHome}`}>
      <Logo markOnly />
    </a>

    <div class="dock__status" aria-hidden="true">
      <span class="label dock__idx tabular" data-dock-idx>00</span>
      <span class="label dock__current" data-dock-current>{site.identity.name}</span>
    </div>

    <div class="dock__collapse">
      <ul class="dock__links">
        {nav.filter((n) => n.id !== 'home').map((n) => (
          <li>
            <a href={n.href} class="label link-u" aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
          </li>
        ))}
      </ul>
    </div>

    {wa && (
      <a class="dock__wa label" href={wa} target="_blank" rel="noopener noreferrer" aria-label={`${ui.whatsapp} (${ui.opensNewTab})`}>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.4-.3Z"/></svg>
        <span class="dock__wa-label">{ui.whatsapp}</span>
      </a>
    )}

    <button class="dock__toggle label" type="button" aria-expanded="false" aria-controls="menu-panel" data-menu-toggle>
      <span class="dock__toggle-text" data-open-label={ui.menu} data-close-label={ui.close}>{ui.menu}</span>
      <span class="burger" aria-hidden="true"><i></i><i></i></span>
    </button>
    <span class="dock__progress" aria-hidden="true"><i data-dock-progress></i></span>
  </nav>

  <div class="menu" id="menu-panel" data-menu role="dialog" aria-modal="true" aria-label={ui.menu} inert>
    <div class="menu__inner container">
      <nav class="menu__primary" aria-label={ui.pages}>
        <ol>
          {nav.map((n, i) => (
            <li style={`--i:${i}`}>
              <a href={n.href} class="menu__link" aria-current={isCurrent(n.href) ? 'page' : undefined}>
                <span class="label menu__num tabular">{pad(i + 1)}</span>
                <span class="display menu__label">{n.label}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="menu__side">
        {index.length > 1 && (
          <nav class="menu__index" aria-label={ui.onThisPage}>
            <p class="label subtle">{ui.onThisPage}</p>
            <ul>
              {index.map((s, i) => (
                <li style={`--i:${i}`}>
                  <a href={`#${s.anchor}`} class="link-u" data-menu-anchor>{s.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        <div class="menu__contact">
          <p class="label subtle">{ui.contact}</p>
          <a class="link-u" href={`mailto:${c.email}`}>{c.email}</a>
          <a class="link-u" href={c.phone.href}>{c.phone.display}</a>
          <p class="muted">{c.address.street}<br />{c.address.city} · {c.address.region}</p>
          <ul class="menu__social">
            {site.social.map((s) => (
              <li><a class="label link-u" href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .dock {
    --dock-h: 3.5rem;
    position: fixed;
    inset: 0 0 auto;
    z-index: 800;
    pointer-events: none;
    view-transition-name: dock;
  }
  .dock__bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 1.6vw, 1.75rem);
    width: max-content;
    max-width: calc(100% - 2rem);
    height: var(--dock-h);
    margin: 1rem auto 0;
    padding: 0 0.5rem 0 0.9rem;
    pointer-events: auto;
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
    backdrop-filter: blur(18px) saturate(1.2);
    border: var(--shape-border) solid var(--color-line);
    border-radius: var(--shape-radius);
    color: var(--color-ink);
    transition: transform 0.7s var(--motion-ease-out), background-color 0.4s;
  }
  .dock__brand {
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
  }
  .dock__brand :global(img) {
    width: 22px;
    height: 22px;
  }
  .dock__status {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    min-width: 9.5rem;
    white-space: nowrap;
    color: var(--color-ink-muted);
  }
  .dock__idx {
    color: var(--color-accent);
  }
  .dock__current {
    display: inline-block;
    transition: opacity 0.3s, transform 0.4s var(--motion-ease-out);
  }
  .dock__current.is-swapping {
    opacity: 0;
    transform: translateY(-40%);
  }
  .dock__collapse {
    display: grid;
    grid-template-columns: 1fr;
    transition: grid-template-columns 0.7s var(--motion-ease-out), opacity 0.4s;
  }
  .dock__links {
    display: flex;
    gap: 1.6rem;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    padding-inline: 0.2rem;
  }
  .dock__links a[aria-current='page'] {
    color: var(--color-accent);
  }
  .dock[data-state='compact'] .dock__collapse {
    grid-template-columns: 0fr;
    opacity: 0;
  }
  .dock__wa {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    height: 2.5rem;
    padding: 0 0.9rem;
    border: var(--shape-border) solid var(--color-line);
    border-radius: var(--shape-button-radius);
    transition: background 0.3s, color 0.3s;
  }
  .dock__wa:hover {
    background: var(--color-ink);
    color: var(--color-bg);
  }
  .dock__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    height: 2.5rem;
    padding: 0 0.9rem;
    background: var(--color-ink);
    color: var(--color-bg);
    border-radius: var(--shape-button-radius);
  }
  .burger {
    position: relative;
    width: 18px;
    height: 8px;
  }
  .burger i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition: transform 0.5s var(--motion-ease-out), top 0.5s var(--motion-ease-out);
  }
  .burger i:first-child {
    top: 0;
  }
  .burger i:last-child {
    top: 7px;
  }
  .dock.is-open .burger i:first-child {
    top: 3.5px;
    transform: rotate(45deg);
  }
  .dock.is-open .burger i:last-child {
    top: 3.5px;
    transform: rotate(-45deg);
  }
  .dock__progress {
    position: absolute;
    left: -1px;
    right: -1px;
    bottom: -1px;
    height: 1px;
    overflow: hidden;
  }
  .dock__progress i {
    display: block;
    height: 100%;
    background: var(--color-accent);
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
  }

  /* ---------- Menu panel ---------- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    padding-block: 7rem 4rem;
    overflow-y: auto;
    background: var(--color-bg);
    pointer-events: none;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.9s var(--motion-ease);
    overscroll-behavior: contain;
  }
  .dock.is-open .menu {
    pointer-events: auto;
    clip-path: inset(0 0 0% 0);
  }
  .menu__inner {
    display: grid;
    gap: 3rem;
    width: 100%;
  }
  .menu__primary ol {
    border-top: var(--shape-border) solid var(--color-line);
  }
  .menu__primary li {
    border-bottom: var(--shape-border) solid var(--color-line);
    overflow: hidden;
  }
  .menu__link {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    padding: 0.4rem 0;
    transform: translateY(105%);
    transition: transform 0.9s var(--motion-ease-out) calc(0.25s + var(--i) * 0.06s), color 0.3s;
  }
  .dock.is-open .menu__link {
    transform: none;
  }
  .menu__label {
    font-size: clamp(2.8rem, 9vw, 7.5rem);
    transition: transform 0.6s var(--motion-ease-out);
  }
  .menu__link:hover .menu__label,
  .menu__link:focus-visible .menu__label {
    transform: translateX(1.5rem);
  }
  .menu__link[aria-current='page'] {
    color: var(--color-accent);
  }
  .menu__num {
    color: var(--color-ink-subtle);
    min-width: 2ch;
  }
  .menu__side {
    display: grid;
    gap: 2.5rem;
    align-content: end;
    opacity: 0;
    transform: translateY(1rem);
    transition: opacity 0.6s 0.1s, transform 0.8s var(--motion-ease-out);
  }
  .dock.is-open .menu__side {
    opacity: 1;
    transform: none;
    transition-delay: 0.5s;
  }
  .menu__index ul,
  .menu__contact {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
    justify-items: start;
  }
  .menu__contact .label {
    margin-bottom: 0.25rem;
  }
  .menu__social {
    display: flex;
    gap: 1.25rem;
    margin-top: 1rem;
  }
  @media (min-width: 900px) {
    .menu__inner {
      grid-template-columns: 7fr 3fr;
      gap: var(--layout-gutter);
      align-items: end;
    }
  }

  /* ---------- Mobile: bottom dock ---------- */
  @media (max-width: 899px) {
    .dock {
      inset: auto 0 0;
    }
    .dock__bar {
      width: auto;
      max-width: none;
      margin: 0 0.75rem calc(0.75rem + env(safe-area-inset-bottom));
      justify-content: space-between;
      gap: 0.6rem;
    }
    .dock__collapse {
      display: none;
    }
    .dock__status {
      flex: 1;
      min-width: 0;
      overflow: hidden;
    }
    .dock__wa-label {
      display: none;
    }
    .dock__wa {
      width: 2.5rem;
      padding: 0;
      justify-content: center;
    }
    .dock__progress {
      top: -1px;
      bottom: auto;
    }
    .dock[data-state='hidden'] .dock__bar {
      transform: translateY(calc(100% + 1.5rem));
    }
    .menu {
      align-items: flex-start;
      padding-block: 5rem 7rem;
      clip-path: inset(100% 0 0 0);
    }
  }
  @media (min-width: 900px) {
    .dock[data-state='hidden'] .dock__bar {
      transform: translateY(calc(-100% - 1.5rem));
    }
  }
</style>

<script>
  import { lockScroll } from '../scripts/motion/core';

  const dock = document.querySelector<HTMLElement>('[data-dock]');
  if (dock) {
    const toggle = dock.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
    const toggleText = toggle.querySelector<HTMLElement>('.dock__toggle-text')!;
    const panel = dock.querySelector<HTMLElement>('[data-menu]')!;
    const currentEl = dock.querySelector<HTMLElement>('[data-dock-current]')!;
    const idxEl = dock.querySelector<HTMLElement>('[data-dock-idx]')!;
    const progress = dock.querySelector<HTMLElement>('[data-dock-progress]')!;
    let open = false;
    let lastFocus: HTMLElement | null = null;

    const setOpen = (value: boolean) => {
      open = value;
      dock.classList.toggle('is-open', open);
      dock.dataset.state = open ? 'expanded' : dock.dataset.state;
      toggle.setAttribute('aria-expanded', String(open));
      toggleText.textContent = open ? toggleText.dataset.closeLabel! : toggleText.dataset.openLabel!;
      panel.inert = !open;
      lockScroll(open);
      if (open) {
        lastFocus = document.activeElement as HTMLElement;
        requestAnimationFrame(() => panel.querySelector<HTMLElement>('a')?.focus({ preventScroll: true }));
      } else {
        lastFocus?.focus({ preventScroll: true });
      }
    };

    toggle.addEventListener('click', () => setOpen(!open));
    document.addEventListener('keydown', (e) => {
      if (!open) return;
      if (e.key === 'Escape') setOpen(false);
      if (e.key === 'Tab') {
        // focus trap: bar + panel
        const items = Array.from(dock.querySelectorAll<HTMLElement>('a[href], button')).filter((el) => !el.closest('[inert]') && el.offsetParent !== null);
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });
    panel.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest('a');
      if (a) setOpen(false);
    });

    /* Scroll state: compact on scroll down, expanded on scroll up / top. */
    let lastY = window.scrollY;
    let ticking = false;
    const isMobile = () => window.matchMedia('(max-width: 899px)').matches;
    const update = () => {
      ticking = false;
      const y = window.scrollY;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      progress.style.setProperty('--progress', String(max > 0 ? Math.min(1, y / max) : 0));
      if (open) return;
      const down = y > lastY + 4;
      const up = y < lastY - 4;
      if (y < 120) dock.dataset.state = 'expanded';
      else if (down) dock.dataset.state = isMobile() && y > 600 ? 'compact' : 'compact';
      else if (up) dock.dataset.state = 'expanded';
      lastY = y;
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    dock.addEventListener('pointerenter', () => { if (!isMobile()) dock.dataset.state = 'expanded'; });
    dock.addEventListener('focusin', () => (dock.dataset.state = 'expanded'));
    update();

    /* Current section indicator */
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-label]'));
    if (sections.length) {
      let active: HTMLElement | null = null;
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting || entry.target === active) continue;
            active = entry.target as HTMLElement;
            const label = active.dataset.navLabel || '';
            const i = sections.indexOf(active) + 1;
            currentEl.classList.add('is-swapping');
            setTimeout(() => {
              currentEl.textContent = label;
              idxEl.textContent = String(i).padStart(2, '0');
              currentEl.classList.remove('is-swapping');
            }, 220);
          }
        },
        { rootMargin: '-45% 0px -50% 0px' }
      );
      sections.forEach((s) => io.observe(s));
    }
  }
</script>
